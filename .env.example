# Values prefixed with VITE_ are public and bundled into browser JavaScript.
# Never put passwords, private API keys, AWS credentials, or client secrets here.

# Local demo: mock
# Production/staging: api
VITE_DATA_SOURCE=api

# Public application origin. CloudFront must route /api/* to the BFF.
# Keeping SPA and BFF on one origin preserves host-only Secure cookies.
VITE_API_BASE_URL=https://app.example.invalid
