{
  "name": "sntimnt-auth-bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/handler.mjs --sourcemap",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run check && npm test && npm run build",
    "sam:build": "sam build"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/node": "22.16.5",
    "esbuild": "0.28.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1090.0",
    "@aws-sdk/client-dynamodb": "3.1090.0",
    "@aws-sdk/client-kms": "3.1090.0"
  }
}
